rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================
    // ADMIN USERS - Allow authenticated users to read admin data for login
    // ===========================================
    match /adminUsers/{userId} {
      // Allow read for authentication (users need to check if they exist in adminUsers)
      allow read: if request.auth != null;

      // Allow super admins to manage admin users
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'super_admin';

      // Allow users to read their own admin record
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ===========================================
    // CUSTOMERS - Admin and Manager Access
    // ===========================================
    match /customers/{customerId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // EMPLOYEES - Admin Access
    // ===========================================
    match /employees/{employeeId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // PROJECTS - Admin and Manager Access
    // ===========================================
    match /projects/{projectId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // INSTALLATIONS - Admin and Employee Access
    // ===========================================
    match /installations/{installationId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );

      // Allow employees to read installations
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'employee';
    }

    // ===========================================
    // PAYMENTS - Admin and Manager Access
    // ===========================================
    match /payments/{paymentId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // MATERIAL DISPATCH - Admin Access
    // ===========================================
    match /materialDispatches/{dispatchId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // MATERIAL BILLS - Admin Access
    // ===========================================
    match /materialBills/{billId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // LEADS - Admin Read, Public Write
    // ===========================================
    match /leads/{leadId} {
      // Allow anyone to submit leads
      allow create: if true;

      // Allow admins to read/update/delete
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // CONTACTS - Admin Read, Public Write
    // ===========================================
    match /contacts/{contactId} {
      // Allow anyone to submit contacts
      allow create: if true;

      // Allow admins to read/update/delete
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin', 'manager'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // CAREERS - Admin Read, Public Write
    // ===========================================
    match /careers/{applicationId} {
      // Allow anyone to submit applications
      allow create: if true;

      // Allow admins to read/update/delete
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // JOBS - Public Read, Admin Write
    // ===========================================
    match /jobs/{jobId} {
      // Allow public to read jobs
      allow read: if true;

      // Allow admins to manage jobs
      allow write: if request.auth != null &&
        ['super_admin', 'admin'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // CONTENT - Admin Access
    // ===========================================
    match /content/{contentId} {
      allow read, write: if request.auth != null &&
        ['super_admin', 'admin'].hasAny(
          get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role
        );
    }

    // ===========================================
    // DEVELOPMENT FALLBACK - Allow all operations for development
    // ===========================================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}</content>
<parameter name="filePath">firestore.rules